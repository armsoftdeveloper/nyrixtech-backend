# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,nyrix.tech,www.nyrix.tech

# Database (PostgreSQL) — leave POSTGRES_HOST blank for local dev (falls back to SQLite).
# Set POSTGRES_HOST=postgres (or your real host) only when running via docker-compose / production.
POSTGRES_DB=nyrixtech
POSTGRES_USER=nyrixtech
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS / CSRF — frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nyrix.tech
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://nyrix.tech

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# HSTS — only enable once HTTPS is confirmed working on every host in ALLOWED_HOSTS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Email (used for lead/audit/ticket notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@nyrix.tech
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@nyrix.tech
COMPANY_NOTIFY_EMAIL=leads@nyrix.tech

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Analytics: Google Analytics 4 is configured on the frontend via VITE_GA_MEASUREMENT_ID
# in frontend/.env — there is no backend-side analytics configuration.
